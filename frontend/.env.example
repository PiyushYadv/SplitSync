# Backend API base URL as the browser sees it, including the /api prefix.
# Local development: the browser calls the backend directly.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Production (e.g. Vercel): the browser calls this app's own /api, which next.config.ts proxies to
# the backend, so the session cookie is first-party:
#   NEXT_PUBLIC_API_URL=/api
#   API_INTERNAL_URL=https://<your-backend>.onrender.com/api
#
# API_INTERNAL_URL is also what server components use to reach the backend. It defaults to
# NEXT_PUBLIC_API_URL, so it's only required when that is relative.
# API_INTERNAL_URL=http://localhost:8080/api
